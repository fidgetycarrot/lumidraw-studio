{
  "version": "1.6.6",
  "name": "Lumi Studio",
  "identifier": "lumidraw_studio",
  "author": "fidgetycarrot",
  "github": "https://github.com/fidgetycarrot/lumidraw-studio",
  "homepage": "https://github.com/fidgetycarrot/lumidraw-studio",
  "description": "Story illustration studio with Draw Things and SwarmUI renderers, character libraries, and visual continuity.",
  "permissions": [
    "images",
    "image_gen",
    "cors_proxy",
    "chats",
    "chat_mutation",
    "interceptor",
    "generation",
    "generation_parameters",
    "characters",
    "personas",
    "app_manipulation",
    "event_tracking"
  ],
  "requested_capabilities": [
    "base64_decode"
  ],
  "entry_backend": "backend.js",
  "entry_frontend": "frontend.js",
  "minimum_lumiverse_version": "1.0.1"
}
