{
  "version": "0.14.2",
  "name": "LumiDraw Studio",
  "identifier": "lumidraw_studio",
  "author": "fidgetycarrot",
  "github": "https://github.com/fidgetycarrot/lumidraw-studio",
  "homepage": "https://github.com/fidgetycarrot/lumidraw-studio",
  "description": "Bridge Draw Things and Lumiverse: keep stable chat presets while experimenting with model, sampler, steps, CFG, size, and LoRAs in a temporary workspace.",
  "permissions": [
    "images",
    "image_gen",
    "cors_proxy",
    "chats",
    "chat_mutation",
    "interceptor",
    "generation",
    "characters",
    "personas"
  ],
  "requested_capabilities": [
    "base64_decode"
  ],
  "entry_backend": "backend.js",
  "entry_frontend": "frontend.js",
  "minimum_lumiverse_version": "0.1.0"
}
